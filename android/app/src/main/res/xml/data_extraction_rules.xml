<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rule as backup_rules.xml, for cloud
     backups and transfers to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="accounts/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts/"/>
    </device-transfer>
</data-extraction-rules>
