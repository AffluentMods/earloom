  "fixed_sql": [
    {
      "name": "local_books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_books\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"subtitle\" TEXT NULL, \"authors\" TEXT NOT NULL, \"narrators\" TEXT NOT NULL, \"series_name\" TEXT NULL, \"series_sequence\" TEXT NULL, \"description\" TEXT NULL, \"genres\" TEXT NOT NULL, \"published_year\" TEXT NULL, \"publisher\" TEXT NULL, \"language\" TEXT NULL, \"cover_file\" TEXT NULL, \"source_format\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"size_bytes\" INTEGER NOT NULL DEFAULT 0, \"fingerprint\" TEXT NOT NULL, \"chapters_from_files\" INTEGER NOT NULL DEFAULT 1 CHECK (\"chapters_from_files\" IN (0, 1)), \"sort_title\" TEXT NOT NULL, \"sort_author\" TEXT NOT NULL, \"search_text\" TEXT NOT NULL, \"added_at_ms\" INTEGER NOT NULL, \"updated_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_files\" (\"book_id\" TEXT NOT NULL REFERENCES local_books (id) ON DELETE CASCADE, \"idx\" INTEGER NOT NULL, \"file_name\" TEXT NOT NULL, \"original_name\" TEXT NOT NULL, \"duration_ms\" INTEGER NOT NULL DEFAULT 0, \"size_bytes\" INTEGER NOT NULL, \"mime_type\" TEXT NOT NULL, \"track_number\" INTEGER NULL, \"disc_number\" INTEGER NULL, PRIMARY KEY (\"book_id\", \"idx\"));"
        }
      ]
    },
    {
      "name": "local_chapters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_chapters\" (\"book_id\" TEXT NOT NULL REFERENCES local_books (id) ON DELETE CASCADE, \"idx\" INTEGER NOT NULL, \"title\" TEXT NULL, \"start_ms\" INTEGER NOT NULL, \"end_ms\" INTEGER NOT NULL, PRIMARY KEY (\"book_id\", \"idx\"));"
        }
      ]
    },
    {
      "name": "local_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_progress\" (\"book_id\" TEXT NOT NULL REFERENCES local_books (id) ON DELETE CASCADE, \"position_ms\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"is_finished\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_finished\" IN (0, 1)), \"finished_at_ms\" INTEGER NULL, \"updated_at_ms\" INTEGER NOT NULL, \"last_played_at_ms\" INTEGER NULL, \"listened_ms\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"book_id\"));"
        }
      ]
    },
    {
      "name": "local_bookmarks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_bookmarks\" (\"book_id\" TEXT NOT NULL REFERENCES local_books (id) ON DELETE CASCADE, \"position_ms\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"created_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"book_id\", \"position_ms\"));"
        }
      ]
    },
    {
      "name": "local_books_sort_title",
