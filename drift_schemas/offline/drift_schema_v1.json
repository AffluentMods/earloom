  "fixed_sql": [
    {
      "name": "downloads",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"downloads\" (\"key\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"episode_id\" TEXT NULL, \"library_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NULL, \"cover_path\" TEXT NULL, \"status\" TEXT NOT NULL, \"bytes_total\" INTEGER NOT NULL DEFAULT 0, \"bytes_done\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"error_code\" TEXT NULL, \"auto_reason\" TEXT NULL, \"wifi_only\" INTEGER NOT NULL DEFAULT 1 CHECK (\"wifi_only\" IN (0, 1)), \"finished_at\" INTEGER NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "download_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"download_files\" (\"download_key\" TEXT NOT NULL REFERENCES downloads (\"key\") ON DELETE CASCADE, \"track_index\" INTEGER NOT NULL, \"ino\" TEXT NOT NULL, \"remote_path\" TEXT NOT NULL, \"local_path\" TEXT NOT NULL, \"size_expected\" INTEGER NOT NULL, \"size_actual\" INTEGER NULL, \"status\" TEXT NOT NULL, \"task_id\" TEXT NULL, \"progress\" REAL NOT NULL DEFAULT 0.0, PRIMARY KEY (\"download_key\", \"track_index\"));"
        }
      ]
    },
    {
      "name": "local_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_snapshots\" (\"key\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"episode_id\" TEXT NULL, \"item_json\" TEXT NOT NULL, \"chapters_json\" TEXT NOT NULL, \"tracks_json\" TEXT NOT NULL, \"cover_path\" TEXT NULL, \"saved_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "local_sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_sessions\" (\"id\" TEXT NOT NULL, \"account_id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"episode_id\" TEXT NULL, \"started_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"start_time\" REAL NOT NULL, \"current_time\" REAL NOT NULL, \"time_listened\" REAL NOT NULL, \"duration\" REAL NOT NULL, \"payload_json\" TEXT NOT NULL, \"closed_at\" INTEGER NULL, \"synced_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL, \"episode_id\" TEXT NULL, \"payload_json\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"state\" TEXT NOT NULL DEFAULT 'pending');"
        }
      ]
    }
  ]
