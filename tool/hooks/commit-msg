# Commit message rules. Enabled by tool/bootstrap.sh.
set -euo pipefail
msg=$(grep -v '^#' "$1" || true)

if printf '%s' "$msg" | grep -q -e $'\xe2\x80\x94' -e $'\xe2\x80\x93'; then
  echo "Commit message contains an em or en dash. Use commas, colons, periods or parentheses."
  exit 1
fi
if printf '%s' "$msg" | grep -qiE 'co-authored-by:|generated with|claude-session:'; then
  echo "Commit message contains a tool attribution line. Remove it."
  exit 1
fi
if ! printf '%s' "$msg" | grep -q '^Signed-off-by: '; then
  echo "Missing sign-off (DCO). Commit with: git commit -s"
  exit 1
fi
